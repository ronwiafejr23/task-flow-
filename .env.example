# Copy this file to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: only needed for the Gmail import (Google Cloud → Credentials → OAuth client ID, type "Web application")
VITE_GOOGLE_CLIENT_ID=

# Optional: your school's Canvas address (defaults to https://lincolnu.instructure.com)
VITE_CANVAS_URL=
